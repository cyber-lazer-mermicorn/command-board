# ============================================================
# Mermicorn Command Board — Environment Variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stytch (auth) ---
# https://stytch.com/dashboard → API Keys
STYTCH_PROJECT_ID=
STYTCH_SECRET=
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=

# --- Supabase (primary DB) ---
# https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Neon (edge DB) ---
# https://console.neon.tech → Connection string
NEON_DATABASE_URL=

# --- GitHub ---
# https://github.com/settings/tokens → Fine-grained PAT
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# --- Linear ---
# https://linear.app/settings/api → Personal API Key
LINEAR_API_KEY=

# --- Hugging Face ---
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=

# --- Context7 ---
# https://context7.com → API Key
CONTEXT7_API_KEY=

# --- Postman ---
# https://go.postman.co/settings/me/api-keys
POSTMAN_API_KEY=
