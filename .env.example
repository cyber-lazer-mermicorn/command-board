# ============================================================
# Mermicorn Command Board — Environment Variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Dashboard gate (interim until Stytch fully wired) ---
# If set, /dashboard requires login at /login with this token (httpOnly cookie).
COMMAND_BOARD_ACCESS_TOKEN=

# --- Stytch (auth) ---
# https://stytch.com/dashboard → API Keys
STYTCH_PROJECT_ID=
STYTCH_SECRET=
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=

# --- Supabase (primary DB) ---
# https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Neon (edge DB) ---
# https://console.neon.tech → Connection string
NEON_DATABASE_URL=

# --- Sentry (observability + error tracking) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Mermicorn PAT ---
# Fine-grained PAT scoped to cyber-lazer-mermicorn org
MERMICORN_PAT=

# --- GitHub webhook verification ---
GITHUB_WEBHOOK_SECRET=

# --- Vercel ---
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# --- Linear ---
LINEAR_API_KEY=

# --- Hugging Face ---
HUGGINGFACE_API_TOKEN=

# --- Context7 ---
CONTEXT7_API_KEY=

# --- Postman ---
POSTMAN_API_KEY=

# --- Cron (Vercel cron auth) ---
# Generate: openssl rand -hex 32
CRON_SECRET=
