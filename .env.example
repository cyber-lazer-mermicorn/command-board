# ============================================================
# Mermicorn Command Board — Environment Variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stytch (auth) ---
# https://stytch.com/dashboard → API Keys
STYTCH_PROJECT_ID=
STYTCH_SECRET=
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=

# --- Supabase (primary DB) ---
# https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Neon (edge DB) ---
# https://console.neon.tech → Connection string
NEON_DATABASE_URL=

# --- Mermicorn PAT (CRITICAL — full org read/write) ---
# Fine-grained PAT scoped to cyber-lazer-mermicorn org
# Permissions needed:
#   Contents:       Read & Write  (all repos, public + private)
#   Actions:        Read & Write
#   Issues:         Read & Write
#   Pull Requests:  Read & Write
#   Metadata:       Read (required)
#   Deployments:    Read & Write
#   Packages:       Read & Write
#   Secrets:        Read (to verify secrets exist)
#   Workflows:      Read & Write
# https://github.com/settings/tokens?type=beta
MERMICORN_PAT=

# --- GitHub (legacy — keep for webhook verification only) ---
# The MERMICORN_PAT replaces GITHUB_TOKEN for all API calls
GITHUB_WEBHOOK_SECRET=

# --- Vercel ---
# https://vercel.com/account/tokens
VERCEL_TOKEN=
# Project ID from Vercel dashboard → Settings → General
VERCEL_ORG_ID=

# --- Linear ---
# https://linear.app/settings/api → Personal API Key
LINEAR_API_KEY=

# --- Hugging Face ---
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=

# --- Context7 ---
# https://context7.com → API Key
CONTEXT7_API_KEY=

# --- Postman ---
# https://go.postman.co/settings/me/api-keys
POSTMAN_API_KEY=

# --- Cron (Vercel cron auth) ---
# Generate: openssl rand -hex 32
CRON_SECRET=
