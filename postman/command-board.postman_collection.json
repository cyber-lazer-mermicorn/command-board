{
  "info": {
    "name": "Mermicorn Command Board",
    "description": "API test collection for the Mermicorn control plane",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000", "type": "string" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/health"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Status ok', () => { const b = pm.response.json(); pm.expect(b.status).to.equal('ok'); });"
          ]
        }
      }]
    },
    {
      "name": "Integration Status",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/health"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Has integrations map', () => { const b = pm.response.json(); pm.expect(b.integrations).to.be.an('object'); });"
          ]
        }
      }]
    }
  ]
}
